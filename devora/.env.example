# Devora optional add-on env (copied by the installer to a 0600 file; DEVORA_ENV_FILE).
# Every value marked CHANGE_ME must be replaced; manage.sh rejects empty values and CHANGE_ME.
# BE contract: e196ad2aa8c3a5a1f130e443e6173af180304cee
DEVORA_BE_IMAGE=CHANGE_ME
API_BIND=127.0.0.1
API_PORT=CHANGE_ME

APP_ENV=production
AUTH_MODE=enforce
# onprem: leave EDENCREW_ENV empty
EDENCREW_ENV=
CORS_MODE=native
ALLOWED_ORIGINS=
ORG_SCOPE_ENABLED=1
PLAN_LOCK_ENABLED=true
DEPLOYMENT_ORG_ID=CHANGE_ME
THREAD_NAMESPACE_SECRET=CHANGE_ME
TEAMCLOUD_BASE_URL=CHANGE_ME

OIDC_ISSUER=CHANGE_ME
OIDC_AUDIENCE=CHANGE_ME
OIDC_JWKS_URI=CHANGE_ME
OIDC_JWKS_HOST_ALLOWLIST=CHANGE_ME
OIDC_EXPECTED_TYP=CHANGE_ME

# User/DB: lowercase [a-z_][a-z0-9_]{0,62}, not postgres/template0/template1/pg_*; first install only.
POSTGRES_USER=devora
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=devora
# Must point at the dedicated "postgres" service with the same user/password/db.
DATABASE_URL=CHANGE_ME
REDIS_URL=redis://redis:6379/0

LITELLM_BASE_URL=CHANGE_ME
LITELLM_MASTER_KEY=CHANGE_ME
CHAT_MODEL=CHANGE_ME
DESIGN_EDIT_MODEL=CHANGE_ME
SCRIPT_MODEL=CHANGE_ME
# openai: embeddings use LITELLM_BASE_URL/LITELLM_MASTER_KEY + EMBEDDING_MODEL (1024-dim);
#         OLLAMA_BASE_URL may stay empty (an optional background warmup may only warn).
# ollama: OLLAMA_BASE_URL must be the real Ollama endpoint. Other values fail validation.
EMBEDDING_BACKEND=CHANGE_ME
EMBEDDING_MODEL=CHANGE_ME
OLLAMA_BASE_URL=
# Optional: absolute host path of a public PEM CA bundle (approved private roots + public roots;
# it REPLACES the default trust pool). Leave empty to keep the image default trust.
# Example: DEVORA_CA_BUNDLE_FILE=/opt/example/ca/combined-ca.pem
DEVORA_CA_BUNDLE_FILE=

# Optional: adopted (e.g. restored) DB on the same dedicated postgres service, api only.
# Leave empty for the default (api uses DATABASE_URL). POSTGRES_DB/DATABASE_URL are NOT rewritten.
# Format: postgresql://USER:PASSWORD@postgres:5432/DB  (refused by bootstrap)
DEVORA_API_DATABASE_URL=

CONTEXT_PREPARATION_ENABLED=false
CONTEXT_PREPARATION_BINDING_BYPASS=false
WEB_SEARCH_ENABLED=false
LOCAL_RERANKER_ENABLED=false
AI_DATA_ENABLED=false
