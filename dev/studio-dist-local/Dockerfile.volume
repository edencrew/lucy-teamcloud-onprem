# lucy-studio-dist 볼륨 서빙형 참조 구현 (온프렘 로컬 검증용).
# 파일을 굽지 않는다. tc-be 와 공유하는 볼륨을 /srv/studio 에 읽기 전용으로 마운트해 current 를 서빙한다.
# 피드 렌더링은 TC 가 업로드·활성화 때 하므로 entrypoint 도 STUDIO_BASE_URL 도 없다.
FROM nginx:1.26-alpine

COPY nginx.volume.conf /etc/nginx/conf.d/default.conf

RUN rm -f /usr/share/nginx/html/index.html /usr/share/nginx/html/50x.html \
 && mkdir -p /srv/studio
