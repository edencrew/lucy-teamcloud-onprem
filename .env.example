# .env.example

# 외부에서 Lucy 서비스에 접근할 때 사용하는 주소입니다.
# 프로토콜(http:// 또는 https://)을 반드시 포함하세요. localhost/127.0.0.1은 운영용으로 쓰지 마세요.
# Docker 기본 compose: 80/443 publish 예) https://teamcloud.example.com
# Podman 기본 compose: 18080/18443 publish 예) http://teamcloud.example.com:18080
# 이 URL은 compose의 host port publish 설정을 자동으로 바꾸지 않습니다.
# 게시 포트는 TC_HTTP_PORT / TC_HTTPS_PORT 로 바꾸고 아래 URL들을 함께 수정하세요.
#
# 게이트웨이 프로토콜 (새 고정 레이아웃의 teamcloudctl/ops 가 검증):
#   TC_PROTOCOL=https (기본, 생략 가능): nginx/nginx.conf, 80+443 리슨, 리다이렉트 없음
#                                      EXTERNAL_URL=https://호스트:TC_HTTPS_PORT, BROKER_WS_URL=wss://호스트:TC_HTTPS_PORT/mqtt
#   TC_PROTOCOL=http                  : nginx/nginx.http.conf (릴리스 소유 템플릿)
#                                      EXTERNAL_URL=http://호스트:TC_HTTP_PORT,   BROKER_WS_URL=ws://호스트:TC_HTTP_PORT/mqtt
#   PUBLIC_BROKER_WS_URL 은 다른 호스트(DMZ)를 쓸 수 있지만 ws/wss 는 TC_PROTOCOL 과 같아야 합니다.
#   TC_GW_CONFIG / TC_PAYLOAD_DIR 를 .env 에 직접 쓰면 ops 가 거부합니다.
# TC_PROTOCOL=https
# TC_HTTP_PORT=18080
# TC_HTTPS_PORT=18443
EXTERNAL_URL=https://your-domain.com
BROKER_WS_URL=wss://your-domain.com/mqtt
PUBLIC_BROKER_WS_URL=wss://your-public-domain.com/mqtt

# Lucy 서비스 관리자 계정
# LUCY_ADMIN_NAME 은 바꿀 수 없습니다.
LUCY_ADMIN_EMAIL=admin@edencrew.com
LUCY_ADMIN_PASSWORD=your_service_admin_password
LUCY_ADMIN_NAME=admin

# 데이터베이스 초기화 및 접속 정보
# 초기화 이후 변경시 서비스 이용이 불가능합니다.
DB_ROOT_PASSWORD=your_db_root_password
DB_USERNAME=lucy
DB_PASSWORD=your_db_password
# TeamCloud/Auth/Gitea DB names (first install only; [a-z_][a-z0-9_]{0,62}, not postgres/template*/pg_*,
# all three pairwise distinct). All are owned by the shared DB_USERNAME role. Absent => lucy_teamcloud /
# lucy_auth / git. Changing them on an existing install does not rename/migrate data.
TC_DB_NAME=lucy_teamcloud
AUTH_DB_NAME=lucy_auth
GITEA_DB_NAME=git

# 타임존 (예: Asia/Seoul, UTC)
TZ=Asia/Seoul

# Linux 서버에서는 compose 실행 계정의 UID/GID로 반드시 확인/설정하세요 (`id` 명령어로 확인)
HOST_UID=1000
HOST_GID=1000
